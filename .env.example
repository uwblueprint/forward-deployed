# Supabase project URL, found in the project's API settings.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key, found in the project's API settings.
# This project uses Supabase's newer key model, so paste the publishable key
# (sb_publishable_...) here. It is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret key (sb_secret_...). Server-only: it bypasses Row Level
# Security. Never prefix it with NEXT_PUBLIC_, never import it from client
# code, and never commit a real value.
SUPABASE_SECRET_KEY=

# Optional. Password for every account scripts/seed.ts creates. Leave empty to
# have the seed generate one and print it. Dev data only.
SEED_USER_PASSWORD=
